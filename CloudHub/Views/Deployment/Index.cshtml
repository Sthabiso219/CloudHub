
@model CloudHub.Models.ViewModels.DeploymentPageViewModel
@using System.Linq

@{
    ViewBag.Title = "Deploy Application";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool hasProjects = Model.Projects != null
                       && Model.Projects.Any();
}

<div class="deploy-page">
    <div class="deploy-container">

        <!-- BACK BUTTON -->
        <a href="@Url.Action("Index", "CustomerDashboard")"
           class="deploy-back">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>

        <div class="deploy-card">

            <!-- HEADER -->
            <div class="deploy-header">
                <h1>Deploy Application</h1>
                <p>Choose a deployment method</p>
            </div>

            <!-- DEPLOYMENT TABS -->
            <div class="deploy-tabs"
                 role="tablist"
                 aria-label="Deployment method">

                <button type="button"
                        class="deploy-tab active"
                        data-deploy-tab="github"
                        role="tab"
                        aria-selected="true">
                    <i class="fab fa-github"></i>
                    GitHub
                </button>

                <button type="button"
                        class="deploy-tab"
                        data-deploy-tab="visualstudio"
                        role="tab"
                        aria-selected="false">
                    <i class="fas fa-code"></i>
                    Visual Studio
                </button>

                <button type="button"
                        class="deploy-tab"
                        data-deploy-tab="zip"
                        role="tab"
                        aria-selected="false">
                    <i class="fas fa-file-archive"></i>
                    Upload ZIP
                </button>

            </div>

            <!-- SELECT PROJECT -->
            <div class="deploy-field">

                <label for="ProjectId">
                    Select Project
                </label>

                @Html.DropDownListFor(
                         m => m.ProjectId,
                         Model.Projects,
                         "-- Select a project --",
                         new
                         {
                             @class = "deploy-control",
                             id = "ProjectId"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.ProjectId,
                         "",
                         new { @class = "text-danger" }
                     )

                @if (!hasProjects)
                {
                    <p class="deploy-note">
                        You have not created any projects yet.
                        Create a project before deploying.
                    </p>

                    <a href="@Url.Action("Index", "CustomerDashboard")"
                       class="deploy-back">
                        Return to Dashboard
                    </a>
                }

            </div>

            <!-- GITHUB DEPLOYMENT -->
            <section id="githubPanel"
                     class="deploy-panel"
                     data-deploy-panel="github">

                <div class="deploy-panel-heading">
                    <i class="fab fa-github"></i>

                    <h2>GitHub Deployment</h2>

                    <p>
                        Deploy directly from your GitHub repository.
                    </p>
                </div>

                <div class="deploy-field">
                    <label for="repositorySelect">
                        Select Repository
                    </label>

                    <select id="repositorySelect"
                            class="deploy-control"
                            disabled>
                        <option value="">
                            Connect GitHub to view repositories
                        </option>
                    </select>
                </div>

                <div class="deploy-field">
                    <label for="branchSelect">
                        Select Branch
                    </label>

                    <select id="branchSelect"
                            class="deploy-control"
                            disabled>
                        <option value="">
                            Select a repository first
                        </option>
                    </select>
                </div>

                <p class="deploy-note">
                    GitHub repository integration has not
                    been configured yet.
                </p>

            </section>

            <!-- VISUAL STUDIO DEPLOYMENT -->
            <section id="visualstudioPanel"
                     class="deploy-panel"
                     data-deploy-panel="visualstudio"
                     hidden>

                <div class="deploy-panel-heading">
                    <i class="fas fa-code"></i>

                    <h2>Visual Studio Deployment</h2>

                    <p>
                        Publish your application directly
                        from Visual Studio.
                    </p>
                </div>

                <div class="deploy-info">
                    <h3>How it works</h3>

                    <ol>
                        <li>Select your CloudHub project.</li>
                        <li>Download its publishing profile.</li>
                        <li>Open your application in Visual Studio.</li>
                        <li>Import the profile using Publish.</li>
                        <li>Publish your application securely.</li>
                    </ol>
                </div>

                <button type="button"
                        class="deploy-button"
                        disabled>
                    Download Publish Profile
                </button>

                <p class="deploy-note">
                    Publishing profiles will be available
                    after the publishing service is configured.
                </p>

            </section>

            <!-- ZIP DEPLOYMENT -->
            <section id="zipPanel"
                     class="deploy-panel"
                     data-deploy-panel="zip"
                     hidden>

                <div class="deploy-panel-heading">
                    <i class="fas fa-file-archive"></i>

                    <h2>Upload ZIP</h2>

                    <p>
                        Upload your application package
                        for deployment.
                    </p>
                </div>

                <div class="deploy-field">
                    <label for="zipFile">
                        Select ZIP File
                    </label>

                    <input id="zipFile"
                           type="file"
                           accept=".zip"
                           class="deploy-control"
                           disabled />
                </div>

                <p class="deploy-note">
                    Secure ZIP uploading will be enabled
                    when the deployment processing service
                    is ready.
                </p>

            </section>

            <!-- ACTION BUTTONS -->
            <div class="deploy-actions">

                <a href="@Url.Action("Index", "CustomerDashboard")"
                   class="deploy-button deploy-button-outline">
                    Cancel
                </a>

                <button type="button"
                        id="startDeployment"
                        class="deploy-button"
                        disabled>
                    Start Deployment
                </button>

            </div>

        </div>
    </div>
</div>

<!-- JAVASCRIPT INSIDE RAZOR VIEW -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        "use strict";

        const tabs =
            document.querySelectorAll("[data-deploy-tab]");

        const panels =
            document.querySelectorAll("[data-deploy-panel]");

        const projectSelect =
            document.getElementById("ProjectId");

        const startButton =
            document.getElementById("startDeployment");

        tabs.forEach(function (tab) {

            tab.addEventListener("click", function () {

                const selectedMethod =
                    tab.dataset.deployTab;

                tabs.forEach(function (item) {

                    const active =
                        item.dataset.deployTab === selectedMethod;

                    item.classList.toggle("active", active);

                    item.setAttribute(
                        "aria-selected",
                        String(active)
                    );
                });

                panels.forEach(function (panel) {

                    panel.hidden =
                        panel.dataset.deployPanel !== selectedMethod;

                });

            });

        });

        if (projectSelect) {

            projectSelect.addEventListener("change", function () {

                // Deployment remains disabled until the
                // selected method has a working backend.
                if (startButton) {
                    startButton.disabled = true;
                }

            });

        }

    });
</script>
