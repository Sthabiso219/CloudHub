
@model CloudHub.Models.ViewModels.HostedApplicationsPageViewModel
@using System.Linq

@{
    ViewBag.Title = "CloudHub Deployments";
    ViewBag.TopbarLabel = "Deployments";
    ViewBag.ActivePage = "deployments";

    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    bool hasApplications = Model != null
                           && Model.Applications != null
                           && Model.Applications.Any();
}

<div class="deploy-page">
    <div class="deploy-container">

        <!-- BACK TO DASHBOARD -->
        <a href="@Url.Action("Index", "CustomerDashboard")"
           class="deploy-back">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>

        <div class="deploy-workspace">

            <!-- PAGE HEADER -->
            <div class="deploy-workspace-header">
                <h1>CloudHub Deployments</h1>
                <p>Manage your hosted applications</p>
            </div>

            <!-- DEPLOYMENT NAVIGATION -->
            <nav class="deploy-workspace-tabs"
                 aria-label="Deployment navigation">

                <a href="@Url.Action("Index", "Deployment")"
                   class="deploy-workspace-tab active"
                   aria-current="page">
                    Hosted Applications
                </a>

                <a href="@Url.Action("Create", "Deployment")"
                   class="deploy-workspace-tab">
                    Deploy Application
                </a>

            </nav>

            <!-- HOSTED APPLICATIONS CONTENT -->
            <div class="deploy-workspace-content">

                @if (!hasApplications)
                {
                    <!-- EMPTY STATE -->
                    <div class="deploy-empty-state">

                        <i class="fas fa-cloud"></i>

                        <h2>No hosted applications yet</h2>

                        <p>
                            Applications successfully deployed
                            to CloudHub will appear here.
                        </p>

                        <a href="@Url.Action("Create", "Deployment")"
                           class="deploy-button">
                            <i class="fas fa-plus"></i>
                            Deploy Application
                        </a>

                    </div>
                }
                else
                {
                    <!-- APPLICATIONS LIST -->
                    <div class="deploy-applications">

                        @foreach (var app in Model.Applications)
                        {
                            <div class="deploy-application">

                                <!-- APPLICATION INFORMATION -->
                                <div class="deploy-application-info">

                                    <h3>@app.ProjectName</h3>

                                    <p>
                                        @app.Framework
                                        &bull;
                                        @app.DeploymentMethod
                                    </p>

                                    <p>
                                        Last deployed:
                                        @app.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </p>

                                </div>

                                <!-- APPLICATION ACTIONS -->
                                <div class="deploy-application-actions">

                                    <span class="deploy-status">
                                        @app.Status
                                    </span>

                                    <a href="@Url.Action("Details", "Deployment", new { id = app.DeploymentId })"
                                       class="deploy-button">
                                        Manage
                                    </a>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>
    </div>
</div>
