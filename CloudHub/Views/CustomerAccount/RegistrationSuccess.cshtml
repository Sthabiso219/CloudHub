
@{
    ViewBag.Title = "Registration Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string emailStatus = TempData["EmailStatus"] as string;

    bool emailSent = !string.IsNullOrEmpty(emailStatus)
        && emailStatus.Contains("has been sent");
}

<section class="auth-section">
    <div class="auth-card text-center">

        <!-- Success Icon -->
        <div class="mb-3">
            <i class="fas fa-circle-check text-success"
               style="font-size: 55px;"></i>
        </div>

        <!-- Heading -->
        <h3 class="mt-3">
            Account Created Successfully!
        </h3>

        <p class="auth-subtitle mt-3">
            Welcome to CloudHub!
            Your account has been created successfully.
        </p>

        <hr class="my-4" />

        @if (emailSent)
        {
            <!-- Verification Email Sent -->
            <div class="alert alert-success text-start">
                <i class="fas fa-envelope-circle-check me-2"></i>

                <strong>Verification Email Sent!</strong>

                <p class="mb-0 mt-2">
                    We have sent a verification link
                    to your registered email address.
                </p>
            </div>

            <div class="alert alert-info text-start">
                <i class="fas fa-circle-info me-2"></i>

                <strong>What to do next:</strong>

                <ol class="mt-2 mb-0">
                    <li>Open your email inbox.</li>
                    <li>Find the email from CloudHub.</li>
                    <li>Click the verification link.</li>
                    <li>Return to CloudHub and log in.</li>
                </ol>
            </div>

            <p class="text-muted small mt-3">
                The verification link expires after 24 hours.
                If you cannot find the email, check your spam folder.
            </p>
        }
        else
        {
            <!-- Email Delivery Failed -->
            <div class="alert alert-warning text-start">
                <i class="fas fa-triangle-exclamation me-2"></i>

                <strong>Email Verification Pending</strong>

                <p class="mb-0 mt-2">
                    @if (!string.IsNullOrEmpty(emailStatus))
                    {
                        @emailStatus
                    }
                    else
                    {
                        <span>
                            Your account was created,
                            but we could not confirm that
                            the verification email was sent.
                        </span>
                    }
                </p>
            </div>

            <p class="text-muted small mt-3">
                Your account will remain unverified
                until you complete email verification.
                Please contact support if the problem continues.
            </p>
        }

        <!-- Navigation Buttons -->
        <div class="d-grid gap-2 mt-4">

            @if (emailSent)
            {
                <a href="@Url.Action("Login", "CustomerAccount")"
                   class="btn auth-submit-btn">
                    <i class="fas fa-right-to-bracket me-2"></i>
                    Go to Login
                </a>
            }

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-outline-dark">
                <i class="fas fa-house me-2"></i>
                Back to Home
            </a>

        </div>

        <p class="auth-bottom-text mt-4">
            Need help?
            <a href="@Url.Action("Index", "Home")#support">
                Contact Support
            </a>
        </p>

    </div>
</section>
