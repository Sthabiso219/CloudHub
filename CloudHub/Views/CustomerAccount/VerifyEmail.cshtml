
@{
    ViewBag.Title = "Email Verification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-section">
    <div class="auth-card text-center">

        @if (ViewBag.IsSuccess == true)
        {
            <i class="fas fa-circle-check text-success"
               style="font-size: 50px;"></i>

            <h3 class="mt-3">Email Verified!</h3>
        }
        else
        {
            <i class="fas fa-circle-exclamation text-danger"
               style="font-size: 50px;"></i>

            <h3 class="mt-3">Verification Failed</h3>
        }

        <p class="auth-subtitle mt-3">
            @ViewBag.Message
        </p>

        @if (ViewBag.IsSuccess == true)
        {
            <a href="@Url.Action("Login", "CustomerAccount")"
               class="btn auth-submit-btn">
                Continue to Login
            </a>
        }
        else
        {
            <a href="@Url.Action("Index", "Home")"
               class="btn auth-submit-btn">
                Back to Home
            </a>
        }

    </div>
</section>

@{
    ViewBag.Title = "VerifyEmail";
