
@model CloudHub.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-section">
    <div class="auth-card">

        <div class="auth-logo text-center">
            <i class="fas fa-cloud"></i>
            <h2>CloudHub</h2>
        </div>

        <h3 class="text-center mt-3">
            Forgot Password?
        </h3>

        <p class="auth-subtitle text-center">
            Enter your email address to request
            a password reset link.
        </p>

        @using (Html.BeginForm(
            "ForgotPassword",
            "CustomerAccount",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                     true, "",
                     new { @class = "text-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.EmailAddress)

                @Html.TextBoxFor(
                         m => m.EmailAddress,
                         new
                         {
                             @class = "form-control",
                             type = "email",
                             placeholder = "Enter your email"
                         })

                @Html.ValidationMessageFor(
                         m => m.EmailAddress, "",
                         new { @class = "text-danger" })
            </div>

            <button type="submit"
                    class="btn auth-submit-btn w-100">
                Send Reset Link
            </button>
        }

        <p class="auth-bottom-text text-center mt-4">
            Remember your password?
            <a href="@Url.Action("Login", "CustomerAccount")">
                Back to Login
            </a>
        </p>

    </div>
</section>
