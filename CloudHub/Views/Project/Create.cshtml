@model CloudHub.Models.ViewModels.ProjectFormViewModel
@{
    ViewBag.Title = "Create Project"; ViewBag.TopbarLabel = "Projects"; ViewBag.ActivePage = "projects";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<div class="projects-page projects-narrow"><a href="@Url.Action("Index", "Project")" class="deploy-back">&larr; My Projects</a><div class="projects-panel"><h2>Create New Project</h2><p>Set up a new hosting project</p>
@using (Html.BeginForm("Create", "Project", FormMethod.Post)) {
    @Html.AntiForgeryToken() @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="projects-field">@Html.LabelFor(m => m.ProjectName) @Html.TextBoxFor(m => m.ProjectName, new { maxlength = "100", placeholder = "e.g. MyWebsite", required = "required" }) @Html.ValidationMessageFor(m => m.ProjectName)</div>
    <div class="projects-field">@Html.LabelFor(m => m.Framework) @Html.DropDownListFor(m => m.Framework, new SelectList(new[] { "ASP.NET MVC 5", "ASP.NET Core", "Node.js", "Python", "PHP", "Java", "Static HTML" }), "-- Select framework --", new { required = "required" }) @Html.ValidationMessageFor(m => m.Framework)</div>
    <div class="projects-actions"><a class="deploy-button deploy-button-outline" href="@Url.Action("Index", "Project")">Cancel</a><button class="deploy-button" type="submit">Create Project</button></div>
}
</div></div>
