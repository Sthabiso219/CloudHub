
@model CloudHub.Models.ViewModels.CustomerProfileViewModel

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string fullName = (
        (Model.FirstName ?? "") + " " +
        (Model.LastName ?? "")).Trim();

    string initials =
        (string.IsNullOrWhiteSpace(Model.FirstName)
            ? ""
            : Model.FirstName.Substring(0, 1)) +
        (string.IsNullOrWhiteSpace(Model.LastName)
            ? ""
            : Model.LastName.Substring(0, 1));
}

<div class="container py-5">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">My Profile</h2>
            <p class="text-muted mb-0">
                Manage your CloudHub account information
            </p>
        </div>

        <a href="@Url.Action("Index", "CustomerDashboard")"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>
            Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3 mb-4">

                <div class="rounded-circle bg-dark text-white
                            d-flex align-items-center
                            justify-content-center"
                     style="width:70px;height:70px;
                            font-size:24px;font-weight:600;">

                    @initials.ToUpper()
                </div>

                <div>
                    <h4 class="fw-bold mb-1">@fullName</h4>
                    <p class="text-muted mb-0">
                        CloudHub Customer
                    </p>
                </div>

            </div>

            <hr />

            <h5 class="fw-bold mb-4">
                Personal Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted small">
                        First Name
                    </label>
                    <p class="fw-semibold">
                        @Model.FirstName
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Last Name
                    </label>
                    <p class="fw-semibold">
                        @Model.LastName
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Email Address
                    </label>
                    <p class="fw-semibold">
                        @Model.EmailAddress
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Phone Number
                    </label>
                    <p class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not provided"
                            : Model.PhoneNumber)
                    </p>
                </div>

            </div>

            <hr />

            <h5 class="fw-bold mb-4">
                Account Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Email Verification
                    </label>

                    <p>
                        @if (Model.IsEmailVerified)
                        {
                            <span class="badge bg-success">
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Not Verified
                            </span>
                        }
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Account Status
                    </label>

                    <p>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactive
                            </span>
                        }
                    </p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Member Since
                    </label>
                    <p class="fw-semibold">
                        @Model.CreatedAt.ToString("dd MMMM yyyy")
                    </p>
                </div>

            </div>

            <hr />

            <a href="@Url.Action("EditProfile", "CustomerDashboard")"
               class="btn btn-dark px-4">

                <i class="fas fa-pen me-2"></i>
                Edit Profile
            </a>

        </div>
    </div>
</div>
