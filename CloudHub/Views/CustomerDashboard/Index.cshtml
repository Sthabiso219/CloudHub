@model CloudHub.Models.ViewModels.CustomerDashboardViewModel
@{
    // No Layout line: CustomerDashboard/_ViewStart.cshtml applies _DashboardLayout.
    string firstName = Model == null ? "" : (Model.FirstName ?? "").Trim();
    string lastName = Model == null ? "" : (Model.LastName ?? "").Trim();
    string fullName = (firstName + " " + lastName).Trim();

    ViewBag.Title = "Dashboard";
    ViewBag.TopbarLabel = "Overview";
    ViewBag.ActivePage = "dashboard"; // must match activeClass("dashboard") in _DashboardLayout
    ViewBag.UserFullName = fullName;
}

@section styles {
    <link href="@Url.Content("~/Content/customer-dashboard.css")" rel="stylesheet" />
}

<div class="ch-dashboard">

    <!-- LEFT SIDEBAR -->
    <aside class="ch-sidebar">

        <div class="ch-sidebar-brand">
            <i class="fas fa-cloud-upload-alt"></i>
            <span>CloudHub</span>
        </div>

        <nav class="ch-sidebar-nav">

            <a class="ch-nav-link active"
               href="@Url.Action("Index", "CustomerDashboard")">
                <i class="fas fa-house"></i>
                Dashboard
            </a>

            <span class="ch-nav-link ch-nav-disabled">
                <i class="fas fa-folder"></i>
                My Projects
                <small>Soon</small>
            </span>

            <span class="ch-nav-link ch-nav-disabled">
                <i class="fas fa-rocket"></i>
                Deployments
                <small>Soon</small>
            </span>

            <span class="ch-nav-link ch-nav-disabled">
                <i class="fas fa-database"></i>
                Databases
                <small>Soon</small>
            </span>

            <span class="ch-nav-link ch-nav-disabled">
                <i class="fas fa-credit-card"></i>
                Billing
                <small>Soon</small>
            </span>

            <span class="ch-nav-link ch-nav-disabled">
                <i class="fas fa-circle-question"></i>
                Support
                <small>Soon</small>
            </span>

            <a class="ch-nav-link"
               href="@Url.Action("Profile", "CustomerDashboard")">
                <i class="fas fa-gear"></i>
                Settings
            </a>

        </nav>

        <div class="ch-sidebar-bottom">
            @using (Html.BeginForm(
                "Logout",
                "CustomerAccount",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="ch-logout">
                    <i class="fas fa-right-from-bracket"></i>
                    Logout
                </button>
            }
        </div>
    </aside>

    <!-- MAIN AREA -->
    <div class="ch-main">

        <!-- TOP BAR -->
        <header class="ch-topbar">

            <button class="ch-mobile-menu"
                    type="button"
                    id="chMenuToggle"
                    aria-label="Toggle dashboard menu"
                    aria-expanded="false">
                <i class="fas fa-bars"></i>
            </button>

            <div class="ch-topbar-right">

                <span class="ch-notification-icon"
                      title="Notifications coming soon">
                    <i class="far fa-bell"></i>
                </span>

                <div class="dropdown">

                    <button class="ch-account-button dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <span class="ch-avatar">
                            @initials
                        </span>

                        <span>@customerName</span>

                        <i class="fas fa-chevron-down"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <a class="dropdown-item"
                               href="@Url.Action("Profile", "CustomerDashboard")">
                                My Profile
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            @using (Html.BeginForm(
                                "Logout",
                                "CustomerAccount",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="dropdown-item text-danger">
                                    Logout
                                </button>
                            }
                        </li>

                    </ul>
                </div>

            </div>
        </header>

        <!-- DASHBOARD CONTENT -->
        <main class="ch-content">

            <div class="ch-page-heading">
                <h1>Dashboard</h1>
                <p>Overview of your CloudHub account</p>
            </div>

<!-- Summary cards. Replace the dashes with real values when those modules exist. -->
<div class="ch-stats-grid">
    <div class="ch-stat-card">
        <div class="ch-stat-icon"><i class="fas fa-folder"></i></div>
        <span>Projects</span>
        <h2>&mdash;</h2>
    </div>

    <div class="ch-stat-card">
        <div class="ch-stat-icon"><i class="fas fa-rocket"></i></div>
        <span>Deployments</span>
        <h2>&mdash;</h2>
    </div>

    <div class="ch-stat-card">
        <div class="ch-stat-icon"><i class="fas fa-database"></i></div>
        <span>Storage used</span>
        <h2>&mdash;</h2>
    </div>

    <div class="ch-stat-card">
        <div class="ch-stat-icon"><i class="fas fa-credit-card"></i></div>
        <span>Current plan</span>
        <h2>No plan</h2>
    </div>
</div>

<div class="ch-panels-grid">

    <!-- Getting started: more useful than an empty activity list on a new account -->
    <section class="ch-panel">
        <div class="ch-panel-heading">
            <h3>Getting started</h3>
            <span class="ch-muted-link">1 of 4 done</span>
        </div>

        <div class="ch-activity-list">
            <div class="ch-activity-item">
                <span class="ch-activity-dot"></span>
                <div style="flex:1">
                    <strong>Create your account</strong>
                    <small>You're signed in and ready to go.</small>
                </div>
                <span class="ch-chip ch-chip-green"><i class="fas fa-check"></i> Done</span>
            </div>

            <div class="ch-activity-item">
                <span class="ch-activity-dot"></span>
                <div style="flex:1">
                    <strong>Choose a hosting plan</strong>
                    <small>Pick the plan that fits your project.</small>
                </div>
                <span class="ch-soon">Soon</span>
            </div>

            <div class="ch-activity-item">
                <span class="ch-activity-dot"></span>
                <div style="flex:1">
                    <strong>Create your first project</strong>
                    <small>Name it and choose a framework.</small>
                </div>
                <span class="ch-soon">Soon</span>
            </div>

            <div class="ch-activity-item">
                <span class="ch-activity-dot"></span>
                <div style="flex:1">
                    <strong>Deploy your application</strong>
                    <small>Connect GitHub or upload a ZIP file.</small>
                </div>
                <span class="ch-soon">Soon</span>
            </div>
        </div>
    </section>

    <!-- Resource usage -->
    <section class="ch-panel">
        <div class="ch-panel-heading">
            <h3>Resource usage</h3>
        </div>

        <div class="ch-resource-content">
            <div class="ch-usage-ring" style="--usage: 0%;">
                <div class="ch-usage-inner">
                    <strong>0%</strong>
                </div>
            </div>
            <p class="ch-resource-caption">Storage data is not available yet.</p>
        </div>
    </section>

</div>
